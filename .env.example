# ───────────────────────────────────────────────────────────────
#  Voorbeeld van alle instellingen. Vul de echte waarden in bij
#  Vercel → Settings → Environment Variables (of lokaal in .env.local).
#  Zet NOOIT echte keys in GitHub. .env.local staat in .gitignore.
# ───────────────────────────────────────────────────────────────

# Supabase → knop "Connect" bovenaan je project → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://jouw-project-id.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
# Mag publiek zijn; kan door de beveiliging (RLS) niets met persoonsgegevens.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Supabase → Project Settings → API Keys → Secret key (sb_secret_...)
# GEHEIM. Wordt alleen op de server gebruikt. Nooit delen.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Jouw betaallink (Tikkie of betaalverzoek van je bank). Moet met https:// beginnen.
PAYMENT_URL=https://tikkie.me/pay/xxxxxxxx

# Wachtwoord voor de beheerpagina /admin. Minimaal 12 tekens. Verzin zelf iets sterks.
ADMIN_PASSWORD=verzin-een-lang-wachtwoord
